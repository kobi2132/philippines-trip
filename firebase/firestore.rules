rules_version = '2';
// Paste into Firebase console → Firestore Database → Rules.
service cloud.firestore {
  match /databases/{database}/documents {
    function email() { return request.auth.token.email.lower(); }
    function signedIn() { return request.auth != null && request.auth.token.email_verified == true; }
    function isAdmin() { return signedIn() && email() in ['kobi2132@gmail.com']; }
    function tripDoc(tripId) { return get(/databases/$(database)/documents/trips/$(tripId)); }
    function isMember(tripId) { return signedIn() && email() in tripDoc(tripId).data.members; }
    function canTick(tripId) { return isMember(tripId) && tripDoc(tripId).data.members[email()] in ['admin', 'traveler']; }

    match /trips/{tripId} {
      // Members read; only the admin creates or changes the trip and its member list.
      allow read: if isAdmin() || (signedIn() && email() in resource.data.members);
      allow write: if isAdmin();

      // Live flight status, written by the scheduled job (service account bypasses rules).
      match /status/{doc} {
        allow read: if isAdmin() || isMember(tripId);
        allow write: if false;
      }

      // Checklists and "we did it" marks: travelers change them, viewers only read.
      match /shared/{doc} {
        allow read: if isAdmin() || isMember(tripId);
        allow write: if isAdmin() || canTick(tripId);
      }

      // Each person's own device data (e.g. notification tokens).
      match /devices/{deviceId} {
        allow read, write: if isAdmin() || (isMember(tripId) && request.auth.uid == deviceId);
      }
    }
  }
}
